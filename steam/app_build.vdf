"AppBuild"
{
	"AppID" "5732530"	// Patch Squad
	"Desc" "Patch Squad v1.0.1.0 (Korean + English)"
	"ContentRoot" "..\content\"	// PatchSquad-win32-x64 폴더 "안의" 파일들을 여기에 풀기 (PatchSquad.exe가 바로 있어야 함)
	"BuildOutput" "..\output\"
	"Depots"
	{
		"5732531"	// 데포 ID (Steamworks → SteamPipe → 데포에서 확인)
		{
			"FileMapping"
			{
				"LocalPath" "*"
				"DepotPath" "."
				"recursive" "1"
			}
		}
	}
}
